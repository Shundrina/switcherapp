{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(xcodebuild *)",
      "Bash(xcrun simctl *)",
      "Bash(xcrun xcresulttool *)",
      "Bash(xcode-select -p)",
      "Bash(swift build *)",
      "Bash(swift test *)",
      "Bash(swift package *)",
      "Bash(swiftlint *)",
      "Bash(swiftformat *)",
      "Bash(xcbeautify *)"
    ],
    "ask": [
      "Bash(xcrun simctl erase *)",
      "Bash(xcrun simctl delete *)",
      "Edit(**/*.pbxproj)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/Secrets.xcconfig)",
      "Read(**/*.p12)",
      "Read(**/*.p8)",
      "Read(**/*.mobileprovision)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "xcodebuild *",
      "xcrun *",
      "swift build *",
      "swift test *",
      "swift package *"
    ],
    "filesystem": {
      "denyRead": [
        "~/.appstoreconnect",
        "~/Library/MobileDevice/Provisioning Profiles"
      ]
    }
  }
}
